<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:flowable="http://flowable.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" typeLanguage="http://www.w3.org/2001/XMLSchema" expressionLanguage="http://www.w3.org/1999/XPath" targetNamespace="http://www.cresensolutions.com/leave-approval-process" exporter="Flowable Open Source Modeler" exporterVersion="6.8.0">
  <process id="leaveApprovalProcess_1" name="Leave Approval Process" isExecutable="true">
    <documentation>Leave Approval Process with daily reminder scheduler.
      While manager has not approved or rejected, a non-interrupting boundary timer
      fires every 24h, calculates days until leave, and sends reminder email if needed.</documentation>
    <startEvent id="start_leave_request" name="Leave Request
Submitted" flowable:formFieldValidation="true">
      <extensionElements>
        <flowable:formProperty id="userId" type="long"></flowable:formProperty>
        <flowable:formProperty id="username" type="string"></flowable:formProperty>
        <flowable:formProperty id="leaveTypeId" type="long" required="true"></flowable:formProperty>
        <flowable:formProperty id="leaveDates" type="string" required="true"></flowable:formProperty>
        <flowable:formProperty id="reason" type="string" required="true"></flowable:formProperty>
        <flowable:formProperty id="comments" type="string"></flowable:formProperty>
        <flowable:formProperty id="trail" type="string"></flowable:formProperty>
        <flowable:formProperty id="editable" type="boolean" default="true"></flowable:formProperty>
        <flowable:formProperty id="notifyUserIds" type="string"></flowable:formProperty>
      </extensionElements>
    </startEvent>
    <serviceTask id="service_resolve_approver" name="Send Email to
Admin/Manager" flowable:expression="${leaveService.resolveApprover(execution)}">
      <documentation>Resolves approver (manager via createdBy, fallback to ADMIN role).
        Sends initial leave-request notification email.
        Sets: managerUsername, managerEmail, adminEmail.</documentation>
      <extensionElements>
        <flowable:field name="userId">
          <flowable:expression><![CDATA[${userId}]]></flowable:expression>
        </flowable:field>
        <flowable:field name="username">
          <flowable:expression><![CDATA[${username}]]></flowable:expression>
        </flowable:field>
      </extensionElements>
    </serviceTask>
    <userTask id="task_manager_approval" name="Manager or Admin
Approval" flowable:assignee="${managerUsername}" flowable:formFieldValidation="true">
      <documentation>Waits for Manager or Admin to APPROVE or REJECT.
        While this task is pending, the boundary timer fires every 24h
        to check if a reminder email should be sent.</documentation>
      <extensionElements>
        <flowable:formProperty id="actorUsername" type="string" required="true"></flowable:formProperty>
        <flowable:formProperty id="status" type="enum" required="true">
          <flowable:value id="APPROVED" name="APPROVED"></flowable:value>
          <flowable:value id="REJECTED" name="REJECTED"></flowable:value>
        </flowable:formProperty>
        <flowable:formProperty id="rejectionReason" type="string"></flowable:formProperty>
        <modeler:initiator-can-complete xmlns:modeler="http://flowable.org/modeler"><![CDATA[false]]></modeler:initiator-can-complete>
      </extensionElements>
    </userTask>
    <boundaryEvent id="timer_4day_reminder" name="4-Day Reminder
Timer" attachedToRef="task_manager_approval" cancelActivity="false">
      <documentation>Non-interrupting timer. Fires once when 4 days remain before
        the earliest leave date. Sends a 4-DAY reminder to Admin/Manager.
        Uses ${fourDayReminderTime} — set by CalculateReminderScheduleDelegate.</documentation>
      <timerEventDefinition>
        <timeDate>${fourDayReminderTime}</timeDate>
      </timerEventDefinition>
    </boundaryEvent>
    <boundaryEvent id="timer_2day_reminder" name="2-Day Reminder
Timer" attachedToRef="task_manager_approval" cancelActivity="false">
      <documentation>Non-interrupting timer. Fires once when 2 days remain before
        the earliest leave date. Sends a 2-DAY reminder to Admin/Manager.
        Uses ${twoDayReminderTime} — set by CalculateReminderScheduleDelegate.</documentation>
      <timerEventDefinition>
        <timeDate>${twoDayReminderTime}</timeDate>
      </timerEventDefinition>
    </boundaryEvent>
    <serviceTask id="service_calculate_reminder_schedule" name="Calculate Reminder
Schedule" flowable:expression="${leaveService.calculateReminderSchedule(execution)}">
      <documentation>Calculates exact fire times for the 4-day and 2-day boundary timers.
        Reads leaveDates, finds earliest future date, then sets:
          fourDayReminderTime = earliestLeaveDate - 4 days (at 08:00)
          twoDayReminderTime  = earliestLeaveDate - 2 days (at 08:00)
        These are used by the two boundary timers on the approval task.</documentation>
      <extensionElements>
        <flowable:field name="leaveDates">
          <flowable:expression><![CDATA[${leaveDates}]]></flowable:expression>
        </flowable:field>
      </extensionElements>
    </serviceTask>
    <serviceTask id="service_send_4day_reminder_email" name="Send 4-Day Reminder
Email to Admin/Manager" flowable:async="true" flowable:expression="${leaveService.sendFourDayReminderEmail(execution)}">
      <documentation>Triggered by timer_4day_reminder.
        Sends a reminder email to Admin/Manager: leave starts in 4 days, still pending approval.</documentation>
      <extensionElements>
        <flowable:field name="userId">
          <flowable:expression><![CDATA[${userId}]]></flowable:expression>
        </flowable:field>
        <flowable:field name="username">
          <flowable:expression><![CDATA[${username}]]></flowable:expression>
        </flowable:field>
        <flowable:field name="leaveDates">
          <flowable:expression><![CDATA[${leaveDates}]]></flowable:expression>
        </flowable:field>
        <flowable:field name="reason">
          <flowable:expression><![CDATA[${reason}]]></flowable:expression>
        </flowable:field>
        <flowable:field name="reminderType">
          <flowable:string><![CDATA[4DAY]]></flowable:string>
        </flowable:field>
        <flowable:field name="managerEmail">
          <flowable:expression><![CDATA[${managerEmail}]]></flowable:expression>
        </flowable:field>
        <flowable:field name="adminEmail">
          <flowable:expression><![CDATA[${adminEmail}]]></flowable:expression>
        </flowable:field>
      </extensionElements>
    </serviceTask>
    <serviceTask id="service_send_2day_reminder_email" name="Send 2-Day Reminder
Email to Admin/Manager" flowable:async="true" flowable:expression="${leaveService.sendTwoDayReminderEmail(execution)}">
      <documentation>Triggered by timer_2day_reminder.
        Sends a reminder email to Admin/Manager: leave starts in 2 days, still pending approval.</documentation>
      <extensionElements>
        <flowable:field name="userId">
          <flowable:expression><![CDATA[${userId}]]></flowable:expression>
        </flowable:field>
        <flowable:field name="username">
          <flowable:expression><![CDATA[${username}]]></flowable:expression>
        </flowable:field>
        <flowable:field name="leaveDates">
          <flowable:expression><![CDATA[${leaveDates}]]></flowable:expression>
        </flowable:field>
        <flowable:field name="reason">
          <flowable:expression><![CDATA[${reason}]]></flowable:expression>
        </flowable:field>
        <flowable:field name="reminderType">
          <flowable:string><![CDATA[2DAY]]></flowable:string>
        </flowable:field>
        <flowable:field name="managerEmail">
          <flowable:expression><![CDATA[${managerEmail}]]></flowable:expression>
        </flowable:field>
        <flowable:field name="adminEmail">
          <flowable:expression><![CDATA[${adminEmail}]]></flowable:expression>
        </flowable:field>
      </extensionElements>
    </serviceTask>
    <exclusiveGateway id="gateway_approval_decision" name="Status"></exclusiveGateway>
    <serviceTask id="service_update_approved_status" name="Update Status
To Approved" flowable:expression="${leaveService.updateApprovedLeaveStatus(execution)}">
      <extensionElements>
        <flowable:field name="leaveId">
          <flowable:expression><![CDATA[${leaveId}]]></flowable:expression>
        </flowable:field>
        <flowable:field name="actorUsername">
          <flowable:expression><![CDATA[${actorUsername}]]></flowable:expression>
        </flowable:field>
        <flowable:field name="status">
          <flowable:string><![CDATA[APPROVED]]></flowable:string>
        </flowable:field>
      </extensionElements>
    </serviceTask>
    <serviceTask id="service_deduct_leave_balance" name="Deduct Leave
Balance" flowable:async="true" flowable:exclusive="false" flowable:expression="${leaveService.deductLeaveBalance(execution)}">
      <extensionElements>
        <flowable:field name="userId">
          <flowable:expression><![CDATA[${userId}]]></flowable:expression>
        </flowable:field>
        <flowable:field name="leaveTypeId">
          <flowable:expression><![CDATA[${leaveTypeId}]]></flowable:expression>
        </flowable:field>
        <flowable:field name="leaveDates">
          <flowable:expression><![CDATA[${leaveDates}]]></flowable:expression>
        </flowable:field>
      </extensionElements>
    </serviceTask>
    <serviceTask id="service_send_approved_mail" name="Send Approved
Mail" flowable:async="true" flowable:exclusive="false" flowable:expression="${leaveService.sendApprovedLeaveStatusMail(execution)}">
      <extensionElements>
        <flowable:field name="employeeName">
          <flowable:expression><![CDATA[${employeeName}]]></flowable:expression>
        </flowable:field>
        <flowable:field name="leaveType">
          <flowable:expression><![CDATA[${leaveType}]]></flowable:expression>
        </flowable:field>
        <flowable:field name="leaveDates">
          <flowable:expression><![CDATA[${leaveDates}]]></flowable:expression>
        </flowable:field>
        <flowable:field name="reason">
          <flowable:expression><![CDATA[${reason}]]></flowable:expression>
        </flowable:field>
        <flowable:field name="status">
          <flowable:string><![CDATA[APPROVED]]></flowable:string>
        </flowable:field>
        <flowable:field name="actionBy">
          <flowable:expression><![CDATA[${actorUsername}]]></flowable:expression>
        </flowable:field>
        <flowable:field name="notifyUserIds">
          <flowable:expression><![CDATA[${notifyUserIds}]]></flowable:expression>
        </flowable:field>
      </extensionElements>
    </serviceTask>
    <serviceTask id="service_update_rejected_status" name="Update Status
To Rejected" flowable:expression="${leaveService.updateRejectedLeaveStatus(execution)}">
      <extensionElements>
        <flowable:field name="leaveId">
          <flowable:expression><![CDATA[${leaveId}]]></flowable:expression>
        </flowable:field>
        <flowable:field name="actorUsername">
          <flowable:expression><![CDATA[${actorUsername}]]></flowable:expression>
        </flowable:field>
        <flowable:field name="status">
          <flowable:string><![CDATA[REJECTED]]></flowable:string>
        </flowable:field>
        <flowable:field name="rejectionReason">
          <flowable:expression><![CDATA[${rejectionReason}]]></flowable:expression>
        </flowable:field>
      </extensionElements>
    </serviceTask>
    <serviceTask id="service_send_rejected_mail" name="Send Rejected
Mail" flowable:async="true" flowable:exclusive="false" flowable:expression="${leaveService.sendRejectedLeaveStatusMail(execution)}">
      <extensionElements>
        <flowable:field name="employeeName">
          <flowable:expression><![CDATA[${employeeName}]]></flowable:expression>
        </flowable:field>
        <flowable:field name="leaveType">
          <flowable:expression><![CDATA[${leaveType}]]></flowable:expression>
        </flowable:field>
        <flowable:field name="leaveDates">
          <flowable:expression><![CDATA[${leaveDates}]]></flowable:expression>
        </flowable:field>
        <flowable:field name="reason">
          <flowable:expression><![CDATA[${reason}]]></flowable:expression>
        </flowable:field>
        <flowable:field name="status">
          <flowable:string><![CDATA[REJECTED]]></flowable:string>
        </flowable:field>
        <flowable:field name="actionBy">
          <flowable:expression><![CDATA[${actorUsername}]]></flowable:expression>
        </flowable:field>
        <flowable:field name="rejectionReason">
          <flowable:expression><![CDATA[${rejectionReason}]]></flowable:expression>
        </flowable:field>
        <flowable:field name="notifyUserIds">
          <flowable:expression><![CDATA[${notifyUserIds}]]></flowable:expression>
        </flowable:field>
      </extensionElements>
    </serviceTask>
    <endEvent id="end_leave_process" name="Leave Process
Completed"></endEvent>
    <sequenceFlow id="flow_start_to_resolve" sourceRef="start_leave_request" targetRef="service_resolve_approver"></sequenceFlow>
    <sequenceFlow id="flow_resolve_to_calculate" sourceRef="service_resolve_approver" targetRef="service_calculate_reminder_schedule"></sequenceFlow>
    <sequenceFlow id="flow_calculate_to_task" sourceRef="service_calculate_reminder_schedule" targetRef="task_manager_approval"></sequenceFlow>
    <sequenceFlow id="flow_task_to_decision" sourceRef="task_manager_approval" targetRef="gateway_approval_decision"></sequenceFlow>
    <sequenceFlow id="flow_approved" name="APPROVED" sourceRef="gateway_approval_decision" targetRef="service_update_approved_status">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${status == 'APPROVED'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_approved_to_deduct" sourceRef="service_update_approved_status" targetRef="service_deduct_leave_balance"></sequenceFlow>
    <sequenceFlow id="flow_deduct_to_mail" sourceRef="service_deduct_leave_balance" targetRef="service_send_approved_mail"></sequenceFlow>
    <sequenceFlow id="flow_approved_mail_to_end" sourceRef="service_send_approved_mail" targetRef="end_leave_process"></sequenceFlow>
    <sequenceFlow id="flow_rejected" name="REJECTED" sourceRef="gateway_approval_decision" targetRef="service_update_rejected_status">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${status == 'REJECTED'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_rejected_to_mail" sourceRef="service_update_rejected_status" targetRef="service_send_rejected_mail"></sequenceFlow>
    <sequenceFlow id="flow_rejected_mail_to_end" sourceRef="service_send_rejected_mail" targetRef="end_leave_process"></sequenceFlow>
    <sequenceFlow id="flow_2day_timer_to_email" sourceRef="timer_2day_reminder" targetRef="service_send_2day_reminder_email"></sequenceFlow>
    <sequenceFlow id="flow_4day_timer_to_email" sourceRef="timer_4day_reminder" targetRef="service_send_4day_reminder_email"></sequenceFlow>
  </process>
