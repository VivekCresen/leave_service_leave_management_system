<?xml version="1.0" encoding="UTF-8"?>
<definitions
  xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  xmlns:flowable="http://flowable.org/bpmn"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
  targetNamespace="http://www.cresensolutions.com/leave-approval-process"
  exporter="Flowable Open Source Modeler"
  exporterVersion="6.8.0">

  <process id="leaveApprovalProcess_1" name="Leave Approval Process" isExecutable="true">
    <documentation>
      Two-level leave approval: Employee submits → Manager approves/rejects →
      If manager approves, Admin gives final approval/rejection.
      4-day and 2-day reminder timers fire on both the manager task and the admin task.
      Emails sent at every stage: submission, manager decision, admin decision.
    </documentation>

    <!-- ═══════════════════════════════════════════════════════════
         START
    ═══════════════════════════════════════════════════════════ -->
    <startEvent id="start_leave_request" name="Leave Request Submitted" flowable:formFieldValidation="true">
      <extensionElements>
        <flowable:formProperty id="userId"       type="long"    xmlns:flowable="http://flowable.org/bpmn"/>
        <flowable:formProperty id="username"     type="string"  xmlns:flowable="http://flowable.org/bpmn"/>
        <flowable:formProperty id="leaveTypeId"  type="long"    required="true" xmlns:flowable="http://flowable.org/bpmn"/>
        <flowable:formProperty id="leaveDates"   type="string"  required="true" xmlns:flowable="http://flowable.org/bpmn"/>
        <flowable:formProperty id="reason"       type="string"  required="true" xmlns:flowable="http://flowable.org/bpmn"/>
        <flowable:formProperty id="comments"     type="string"  xmlns:flowable="http://flowable.org/bpmn"/>
        <flowable:formProperty id="trail"        type="string"  xmlns:flowable="http://flowable.org/bpmn"/>
        <flowable:formProperty id="editable"     type="boolean" default="true"  xmlns:flowable="http://flowable.org/bpmn"/>
        <flowable:formProperty id="notifyUserIds" type="string" xmlns:flowable="http://flowable.org/bpmn"/>
      </extensionElements>
    </startEvent>

    <!-- ═══════════════════════════════════════════════════════════
         STEP 1 — Resolve approver + send initial email to manager
    ═══════════════════════════════════════════════════════════ -->
    <serviceTask id="service_resolve_approver" name="Resolve Approver&#10;+ Notify Manager"
      flowable:expression="${leaveService.resolveApprover(execution)}">
      <documentation>
        Resolves manager (via createdBy) or falls back to ADMIN.
        Sends pending-approval email to manager/admin.
        Sets: managerUsername, managerEmail, adminEmail, employeeName, leaveType.
      </documentation>
    </serviceTask>

    <!-- ═══════════════════════════════════════════════════════════
         STEP 2 — Calculate reminder schedule (shared by both tasks)
    ═══════════════════════════════════════════════════════════ -->
    <serviceTask id="service_calculate_reminder_schedule" name="Calculate Reminder&#10;Schedule"
      flowable:expression="${leaveService.calculateReminderSchedule(execution)}">
      <documentation>
        Finds earliest leave date, sets:
          fourDayReminderTime = earliestDate - 4 days at 08:00
          twoDayReminderTime  = earliestDate - 2 days at 08:00
        Used by boundary timers on both manager and admin tasks.
      </documentation>
      <extensionElements>
        <flowable:field name="leaveDates" xmlns:flowable="http://flowable.org/bpmn">
          <flowable:expression>${leaveDates}</flowable:expression>
        </flowable:field>
      </extensionElements>
    </serviceTask>

    <!-- ═══════════════════════════════════════════════════════════
         STEP 3 — Manager approval user task + reminder timers
    ═══════════════════════════════════════════════════════════ -->
    <userTask id="task_manager_approval" name="Manager Approval"
      flowable:assignee="${managerUsername}" flowable:formFieldValidation="true">
      <documentation>
        Waits for Manager (or Admin fallback) to APPROVE or REJECT.
        Non-interrupting boundary timers send 4-day and 2-day reminders.
      </documentation>
      <extensionElements>
        <flowable:formProperty id="actorUsername"   type="string" required="true" xmlns:flowable="http://flowable.org/bpmn"/>
        <flowable:formProperty id="status" type="enum" required="true" xmlns:flowable="http://flowable.org/bpmn">
          <flowable:value id="APPROVED" name="APPROVED"/>
          <flowable:value id="REJECTED" name="REJECTED"/>
        </flowable:formProperty>
        <flowable:formProperty id="rejectionReason" type="string" xmlns:flowable="http://flowable.org/bpmn"/>
        <modeler:initiator-can-complete xmlns:modeler="http://flowable.org/modeler">false</modeler:initiator-can-complete>
      </extensionElements>
    </userTask>

    <!-- Manager task: 4-day reminder timer (non-interrupting) -->
    <boundaryEvent id="timer_mgr_4day" name="Manager 4-Day Reminder"
      attachedToRef="task_manager_approval" cancelActivity="false">
      <timerEventDefinition><timeDate>${fourDayReminderTime}</timeDate></timerEventDefinition>
    </boundaryEvent>

    <!-- Manager task: 2-day reminder timer (non-interrupting) -->
    <boundaryEvent id="timer_mgr_2day" name="Manager 2-Day Reminder"
      attachedToRef="task_manager_approval" cancelActivity="false">
      <timerEventDefinition><timeDate>${twoDayReminderTime}</timeDate></timerEventDefinition>
    </boundaryEvent>

    <!-- Send 4-day reminder to manager -->
    <serviceTask id="service_send_mgr_4day_reminder" name="Send Manager&#10;4-Day Reminder"
      flowable:async="true" flowable:expression="${leaveService.sendReminderEmail(execution)}">
      <extensionElements>
        <flowable:field name="reminderType" xmlns:flowable="http://flowable.org/bpmn"><flowable:string>4DAY</flowable:string></flowable:field>
        <flowable:field name="userId"       xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${userId}</flowable:expression></flowable:field>
        <flowable:field name="username"     xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${username}</flowable:expression></flowable:field>
        <flowable:field name="leaveDates"   xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${leaveDates}</flowable:expression></flowable:field>
        <flowable:field name="reason"       xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${reason}</flowable:expression></flowable:field>
        <flowable:field name="managerEmail" xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${managerEmail}</flowable:expression></flowable:field>
        <flowable:field name="adminEmail"   xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${adminEmail}</flowable:expression></flowable:field>
      </extensionElements>
    </serviceTask>

    <!-- Send 2-day reminder to manager -->
    <serviceTask id="service_send_mgr_2day_reminder" name="Send Manager&#10;2-Day Reminder"
      flowable:async="true" flowable:expression="${leaveService.sendReminderEmail(execution)}">
      <extensionElements>
        <flowable:field name="reminderType" xmlns:flowable="http://flowable.org/bpmn"><flowable:string>2DAY</flowable:string></flowable:field>
        <flowable:field name="userId"       xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${userId}</flowable:expression></flowable:field>
        <flowable:field name="username"     xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${username}</flowable:expression></flowable:field>
        <flowable:field name="leaveDates"   xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${leaveDates}</flowable:expression></flowable:field>
        <flowable:field name="reason"       xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${reason}</flowable:expression></flowable:field>
        <flowable:field name="managerEmail" xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${managerEmail}</flowable:expression></flowable:field>
        <flowable:field name="adminEmail"   xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${adminEmail}</flowable:expression></flowable:field>
      </extensionElements>
    </serviceTask>

    <!-- ═══════════════════════════════════════════════════════════
         STEP 4 — Manager decision gateway
    ═══════════════════════════════════════════════════════════ -->
    <exclusiveGateway id="gateway_manager_decision" name="Manager Decision"/>

    <!-- ═══════════════════════════════════════════════════════════
         STEP 5a — Manager APPROVED path
         Update status → MANAGER_APPROVED, notify admin + employee
    ═══════════════════════════════════════════════════════════ -->
    <serviceTask id="service_set_manager_approved" name="Set Status:&#10;MANAGER_APPROVED"
      flowable:expression="${leaveService.updateLeaveStatusFromFlowable(execution)}">
      <documentation>Sets leave status to MANAGER_APPROVED and records managerApprovedBy.</documentation>
      <extensionElements>
        <flowable:field name="leaveId"       xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${leaveId}</flowable:expression></flowable:field>
        <flowable:field name="actorUsername" xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${actorUsername}</flowable:expression></flowable:field>
        <flowable:field name="status"        xmlns:flowable="http://flowable.org/bpmn"><flowable:string>MANAGER_APPROVED</flowable:string></flowable:field>
      </extensionElements>
    </serviceTask>

    <serviceTask id="service_notify_admin" name="Notify Admin for&#10;Final Approval"
      flowable:async="true" flowable:expression="${leaveService.notifyAdminForFinalApproval(execution)}">
      <documentation>
        Emails admin: manager approved, your final decision needed.
        Emails employee: manager approved, pending admin.
      </documentation>
    </serviceTask>

    <serviceTask id="service_calculate_admin_reminder_schedule" name="Calculate Admin&#10;Reminder Schedule"
      flowable:expression="${leaveService.calculateReminderSchedule(execution)}">
      <documentation>
        Recalculates fourDayReminderTime and twoDayReminderTime based on the
        earliest leave date, so the admin task boundary timers fire correctly.
      </documentation>
    </serviceTask>

    <!-- ═══════════════════════════════════════════════════════════
         STEP 6 — Admin approval user task + reminder timers
    ═══════════════════════════════════════════════════════════ -->
    <userTask id="task_admin_approval" name="Admin Final Approval"
      flowable:candidateGroups="ADMIN" flowable:formFieldValidation="true">
      <documentation>
        Waits for Admin to give final APPROVE or REJECT.
        Non-interrupting boundary timers send 4-day and 2-day reminders to admin.
      </documentation>
      <extensionElements>
        <flowable:formProperty id="actorUsername"   type="string" required="true" xmlns:flowable="http://flowable.org/bpmn"/>
        <flowable:formProperty id="status" type="enum" required="true" xmlns:flowable="http://flowable.org/bpmn">
          <flowable:value id="APPROVED" name="APPROVED"/>
          <flowable:value id="REJECTED" name="REJECTED"/>
        </flowable:formProperty>
        <flowable:formProperty id="rejectionReason" type="string" xmlns:flowable="http://flowable.org/bpmn"/>
        <modeler:initiator-can-complete xmlns:modeler="http://flowable.org/modeler">false</modeler:initiator-can-complete>
      </extensionElements>
    </userTask>

    <!-- Admin task: 4-day reminder timer (non-interrupting) -->
    <boundaryEvent id="timer_admin_4day" name="Admin 4-Day Reminder"
      attachedToRef="task_admin_approval" cancelActivity="false">
      <timerEventDefinition><timeDate>${fourDayReminderTime}</timeDate></timerEventDefinition>
    </boundaryEvent>

    <!-- Admin task: 2-day reminder timer (non-interrupting) -->
    <boundaryEvent id="timer_admin_2day" name="Admin 2-Day Reminder"
      attachedToRef="task_admin_approval" cancelActivity="false">
      <timerEventDefinition><timeDate>${twoDayReminderTime}</timeDate></timerEventDefinition>
    </boundaryEvent>

    <!-- Send 4-day reminder to admin -->
    <serviceTask id="service_send_admin_4day_reminder" name="Send Admin&#10;4-Day Reminder"
      flowable:async="true" flowable:expression="${leaveService.sendReminderEmail(execution)}">
      <extensionElements>
        <flowable:field name="reminderType" xmlns:flowable="http://flowable.org/bpmn"><flowable:string>4DAY</flowable:string></flowable:field>
        <flowable:field name="userId"       xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${userId}</flowable:expression></flowable:field>
        <flowable:field name="username"     xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${username}</flowable:expression></flowable:field>
        <flowable:field name="leaveDates"   xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${leaveDates}</flowable:expression></flowable:field>
        <flowable:field name="reason"       xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${reason}</flowable:expression></flowable:field>
        <flowable:field name="managerEmail" xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${adminEmail}</flowable:expression></flowable:field>
        <flowable:field name="adminEmail"   xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${adminEmail}</flowable:expression></flowable:field>
      </extensionElements>
    </serviceTask>

    <!-- Send 2-day reminder to admin -->
    <serviceTask id="service_send_admin_2day_reminder" name="Send Admin&#10;2-Day Reminder"
      flowable:async="true" flowable:expression="${leaveService.sendReminderEmail(execution)}">
      <extensionElements>
        <flowable:field name="reminderType" xmlns:flowable="http://flowable.org/bpmn"><flowable:string>2DAY</flowable:string></flowable:field>
        <flowable:field name="userId"       xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${userId}</flowable:expression></flowable:field>
        <flowable:field name="username"     xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${username}</flowable:expression></flowable:field>
        <flowable:field name="leaveDates"   xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${leaveDates}</flowable:expression></flowable:field>
        <flowable:field name="reason"       xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${reason}</flowable:expression></flowable:field>
        <flowable:field name="managerEmail" xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${adminEmail}</flowable:expression></flowable:field>
        <flowable:field name="adminEmail"   xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${adminEmail}</flowable:expression></flowable:field>
      </extensionElements>
    </serviceTask>

    <!-- ═══════════════════════════════════════════════════════════
         STEP 7 — Admin decision gateway
    ═══════════════════════════════════════════════════════════ -->
    <exclusiveGateway id="gateway_admin_decision" name="Admin Decision"/>

    <!-- ═══════════════════════════════════════════════════════════
         STEP 8a — APPROVED path (admin approved OR manager rejected skips here)
         Update status → APPROVED, deduct balance, send approval email
    ═══════════════════════════════════════════════════════════ -->
    <serviceTask id="service_set_approved" name="Set Status: APPROVED"
      flowable:expression="${leaveService.updateLeaveStatusFromFlowable(execution)}">
      <extensionElements>
        <flowable:field name="leaveId"       xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${leaveId}</flowable:expression></flowable:field>
        <flowable:field name="actorUsername" xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${actorUsername}</flowable:expression></flowable:field>
        <flowable:field name="status"        xmlns:flowable="http://flowable.org/bpmn"><flowable:string>APPROVED</flowable:string></flowable:field>
      </extensionElements>
    </serviceTask>

    <serviceTask id="service_deduct_balance" name="Deduct Leave Balance"
      flowable:async="true" flowable:exclusive="false"
      flowable:expression="${leaveService.deductLeaveBalance(execution)}">
      <extensionElements>
        <flowable:field name="userId"      xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${userId}</flowable:expression></flowable:field>
        <flowable:field name="leaveTypeId" xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${leaveTypeId}</flowable:expression></flowable:field>
        <flowable:field name="leaveDates"  xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${leaveDates}</flowable:expression></flowable:field>
      </extensionElements>
    </serviceTask>

    <serviceTask id="service_send_approved_mail" name="Send Approval Email&#10;to Employee"
      flowable:async="true" flowable:exclusive="false"
      flowable:expression="${leaveService.sendLeaveStatusMail(execution)}">
      <extensionElements>
        <flowable:field name="status"       xmlns:flowable="http://flowable.org/bpmn"><flowable:string>APPROVED</flowable:string></flowable:field>
        <flowable:field name="employeeName" xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${employeeName}</flowable:expression></flowable:field>
        <flowable:field name="leaveType"    xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${leaveType}</flowable:expression></flowable:field>
        <flowable:field name="leaveDates"   xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${leaveDates}</flowable:expression></flowable:field>
        <flowable:field name="reason"       xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${reason}</flowable:expression></flowable:field>
        <flowable:field name="actionBy"     xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${actorUsername}</flowable:expression></flowable:field>
        <flowable:field name="notifyUserIds" xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${notifyUserIds}</flowable:expression></flowable:field>
      </extensionElements>
    </serviceTask>

    <!-- ═══════════════════════════════════════════════════════════
         STEP 8b — REJECTED path (manager OR admin rejected)
         Update status → REJECTED, send rejection email
    ═══════════════════════════════════════════════════════════ -->
    <serviceTask id="service_set_rejected" name="Set Status: REJECTED"
      flowable:expression="${leaveService.updateLeaveStatusFromFlowable(execution)}">
      <extensionElements>
        <flowable:field name="leaveId"         xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${leaveId}</flowable:expression></flowable:field>
        <flowable:field name="actorUsername"   xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${actorUsername}</flowable:expression></flowable:field>
        <flowable:field name="status"          xmlns:flowable="http://flowable.org/bpmn"><flowable:string>REJECTED</flowable:string></flowable:field>
        <flowable:field name="rejectionReason" xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${rejectionReason}</flowable:expression></flowable:field>
      </extensionElements>
    </serviceTask>

    <serviceTask id="service_send_rejected_mail" name="Send Rejection Email&#10;to Employee"
      flowable:async="true" flowable:exclusive="false"
      flowable:expression="${leaveService.sendLeaveStatusMail(execution)}">
      <extensionElements>
        <flowable:field name="status"          xmlns:flowable="http://flowable.org/bpmn"><flowable:string>REJECTED</flowable:string></flowable:field>
        <flowable:field name="employeeName"    xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${employeeName}</flowable:expression></flowable:field>
        <flowable:field name="leaveType"       xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${leaveType}</flowable:expression></flowable:field>
        <flowable:field name="leaveDates"      xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${leaveDates}</flowable:expression></flowable:field>
        <flowable:field name="reason"          xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${reason}</flowable:expression></flowable:field>
        <flowable:field name="actionBy"        xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${actorUsername}</flowable:expression></flowable:field>
        <flowable:field name="rejectionReason" xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${rejectionReason}</flowable:expression></flowable:field>
        <flowable:field name="notifyUserIds"   xmlns:flowable="http://flowable.org/bpmn"><flowable:expression>${notifyUserIds}</flowable:expression></flowable:field>
      </extensionElements>
    </serviceTask>

    <!-- ═══════════════════════════════════════════════════════════
         END
    ═══════════════════════════════════════════════════════════ -->
    <endEvent id="end_leave_process" name="Leave Process Completed"/>

    <!-- ═══════════════════════════════════════════════════════════
         SEQUENCE FLOWS
    ═══════════════════════════════════════════════════════════ -->

    <!-- Start → Resolve approver → Calculate reminders → Manager task -->
    <sequenceFlow id="flow_start_to_resolve"    sourceRef="start_leave_request"             targetRef="service_resolve_approver"/>
    <sequenceFlow id="flow_resolve_to_calc"     sourceRef="service_resolve_approver"         targetRef="service_calculate_reminder_schedule"/>
    <sequenceFlow id="flow_calc_to_mgr_task"    sourceRef="service_calculate_reminder_schedule" targetRef="task_manager_approval"/>

    <!-- Manager task → Manager decision gateway -->
    <sequenceFlow id="flow_mgr_task_to_gw"      sourceRef="task_manager_approval"            targetRef="gateway_manager_decision"/>

    <!-- Manager reminder timers -->
    <sequenceFlow id="flow_mgr_4day_to_email"   sourceRef="timer_mgr_4day"                   targetRef="service_send_mgr_4day_reminder"/>
    <sequenceFlow id="flow_mgr_2day_to_email"   sourceRef="timer_mgr_2day"                   targetRef="service_send_mgr_2day_reminder"/>

    <!-- Manager APPROVED → set MANAGER_APPROVED → notify admin → Admin task -->
    <sequenceFlow id="flow_mgr_approved" name="APPROVED" sourceRef="gateway_manager_decision" targetRef="service_set_manager_approved">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${status == 'APPROVED'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_mgr_approved_to_notify" sourceRef="service_set_manager_approved"  targetRef="service_notify_admin"/>
    <sequenceFlow id="flow_notify_to_calc_admin"   sourceRef="service_notify_admin"           targetRef="service_calculate_admin_reminder_schedule"/>
    <sequenceFlow id="flow_calc_admin_to_task"     sourceRef="service_calculate_admin_reminder_schedule" targetRef="task_admin_approval"/>

    <!-- Admin task → Admin decision gateway -->
    <sequenceFlow id="flow_admin_task_to_gw"    sourceRef="task_admin_approval"              targetRef="gateway_admin_decision"/>

    <!-- Admin reminder timers -->
    <sequenceFlow id="flow_admin_4day_to_email" sourceRef="timer_admin_4day"                 targetRef="service_send_admin_4day_reminder"/>
    <sequenceFlow id="flow_admin_2day_to_email" sourceRef="timer_admin_2day"                 targetRef="service_send_admin_2day_reminder"/>

    <!-- Admin APPROVED → set APPROVED → deduct balance → send approval email → end -->
    <sequenceFlow id="flow_admin_approved" name="APPROVED" sourceRef="gateway_admin_decision" targetRef="service_set_approved">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${status == 'APPROVED'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_approved_to_deduct"  sourceRef="service_set_approved"             targetRef="service_deduct_balance"/>
    <sequenceFlow id="flow_deduct_to_mail"      sourceRef="service_deduct_balance"            targetRef="service_send_approved_mail"/>
    <sequenceFlow id="flow_approved_mail_to_end" sourceRef="service_send_approved_mail"       targetRef="end_leave_process"/>

    <!-- Manager REJECTED → set REJECTED → send rejection email → end -->
    <sequenceFlow id="flow_mgr_rejected" name="REJECTED" sourceRef="gateway_manager_decision" targetRef="service_set_rejected">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${status == 'REJECTED'}]]></conditionExpression>
    </sequenceFlow>

    <!-- Admin REJECTED → set REJECTED → send rejection email → end -->
    <sequenceFlow id="flow_admin_rejected" name="REJECTED" sourceRef="gateway_admin_decision" targetRef="service_set_rejected">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${status == 'REJECTED'}]]></conditionExpression>
    </sequenceFlow>

    <!-- Shared rejection tail (both manager and admin rejection converge here) -->
    <sequenceFlow id="flow_rejected_to_mail"    sourceRef="service_set_rejected"             targetRef="service_send_rejected_mail"/>
    <sequenceFlow id="flow_rejected_mail_to_end" sourceRef="service_send_rejected_mail"      targetRef="end_leave_process"/>

  </process>

  <!-- ═══════════════════════════════════════════════════════════════════
       DIAGRAM LAYOUT
       Row layout (y-centres):
         Main flow row  y=240  (start → resolve → calc → mgr task → mgr gw → mgr-approved → notify → admin task → admin gw → approved → deduct → mail → end)
         Rejection row  y=420  (set_rejected → send_rejected_mail)
         Mgr reminders  y=420  (below manager task)
         Admin reminders y=420 (below admin task)
  ═══════════════════════════════════════════════════════════════════ -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_leaveApprovalProcess_1">
